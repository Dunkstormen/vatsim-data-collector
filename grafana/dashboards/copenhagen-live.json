      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT $__timeFrom()::timestamptz AS range_start,\n         LEAST($__timeTo()::timestamptz, now()) AS range_end\n), buckets AS (\n  SELECT bucket, GREATEST(bucket, b.range_start) AS period_start,\n         LEAST(bucket + interval '15 minutes', b.range_end) AS period_end\n  FROM bounds b\n  CROSS JOIN LATERAL generate_series(\n    date_bin(interval '15 minutes', b.range_start, timestamptz '1970-01-01 00:00:00+00'),\n    b.range_end - interval '1 microsecond', interval '15 minutes'\n  ) AS bucket\n  WHERE b.range_end > b.range_start\n), counts AS (\n  SELECT date_bin(interval '15 minutes', e.event_at, timestamptz '1970-01-01 00:00:00+00') AS bucket,\n         count(*) FILTER (WHERE e.event_type = 'departure') AS departures,\n         count(*) FILTER (WHERE e.event_type = 'arrival') AS arrivals\n  FROM flight_events e CROSS JOIN bounds b\n  WHERE e.airport = 'EKCH'\n    AND e.event_at >= b.range_start AND e.event_at < b.range_end\n  GROUP BY 1\n), periods AS (\n  SELECT b.period_start, b.period_end,\n         COALESCE(c.departures, 0) AS departures,\n         COALESCE(c.arrivals, 0) AS arrivals\n  FROM buckets b LEFT JOIN counts c USING (bucket)\n)\nSELECT period_start AS \"time\", departures::double precision AS \"Departures\",\n       arrivals::double precision AS \"Arrivals\"\nFROM periods ORDER BY period_start",
          "refId": "A"
        }
      ],
      "title": "Traffic timeline · movements per 15 minutes",
      "description": "Detected EKCH departures (blue) and arrivals (green), stacked in UTC quarter-hour bins. Empty elapsed intervals contain zero recorded events; future intervals are not plotted. First/last bins may be partial. Zero does not establish that the collector had complete coverage.",
      "type": "timeseries"
    },
