      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT $__timeFrom()::timestamptz AS range_start,\n         LEAST($__timeTo()::timestamptz, now()) AS range_end\n), increments AS (\n  SELECT e.event_at,\n         count(*) FILTER (WHERE e.event_type = 'departure') AS departures,\n         count(*) FILTER (WHERE e.event_type = 'arrival') AS arrivals\n  FROM flight_events e CROSS JOIN bounds b\n  WHERE e.airport = 'EKCH'\n    AND e.event_at >= b.range_start AND e.event_at < b.range_end\n  GROUP BY e.event_at\n), times AS (\n  SELECT range_start AS t FROM bounds WHERE range_end > range_start\n  UNION SELECT event_at FROM increments\n  UNION SELECT range_end FROM bounds WHERE range_end > range_start\n)\nSELECT t AS \"time\",\n       sum(COALESCE(i.departures, 0)) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)::double precision AS \"Departures\",\n       sum(COALESCE(i.arrivals, 0)) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)::double precision AS \"Arrivals\"\nFROM times LEFT JOIN increments i ON i.event_at = times.t\nORDER BY t",
          "refId": "A"
        }
      ],
      "title": "Accumulated departures and arrivals",
